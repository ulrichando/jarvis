# Cloud computer-use desktop: virtual X11 + WM + browser + noVNC + the JARVIS sidecar.
FROM python:3.13-slim

# A genuine desktop, not just a browser: pcmanfm draws the desktop surface
# (wallpaper + icons + right-click menu) AND is the file manager; xterm is a
# terminal; mousepad a text editor. The model drives all of them (mouse/
# keyboard + the sandbox bash tool) — the image just has to SHIP the apps and
# paint a desktop behind the windows. (xcalc dropped — no install candidate on
# the trixie slim base; it broke the 2026-07-06 build.)
RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11-utils openbox tint2 firefox-esr \
      pcmanfm xterm mousepad jgmenu \
      x11vnc websockify \
      xdotool wmctrl imagemagick scrot \
      fonts-dejavu-core ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Slim Python deps (sidecar only — no torch/livekit/whisper).
COPY requirements-cu.txt /app/requirements-cu.txt
RUN pip install --no-cache-dir -r requirements-cu.txt

# Sidecar + exactly the modules it imports.
COPY computer_use_service.py /app/
COPY tools/ /app/tools/
COPY pipeline/ /app/pipeline/
COPY scripts/computer-use-container-start.sh /app/start.sh
RUN chmod +x /app/start.sh

# Build-time smoke: the sidecar must import with ONLY the slim deps present.
# If this fails, a transitive import pulled a heavy dep — trim it, don't add torch.
RUN python -c "import computer_use_service; print('sidecar import OK')"

# Non-root
RUN useradd -m -u 10001 cu && chown -R cu:cu /app

# Desktop wallpaper + pcmanfm desktop config so the desktop paints a real
# background (2026-07-06: without this pcmanfm --desktop left a black void — a
# panel over black read as "unfinished"). Wallpaper generated with imagemagick
# (already installed); pcmanfm owns the desktop so its own config is the
# reliable way to set the background — xsetroot needs a package we don't ship.
RUN mkdir -p /usr/share/backgrounds /home/cu/.config/pcmanfm/default /home/cu/Desktop \
 && convert -size 1280x800 gradient:'#26374d'-'#0f1620' /usr/share/backgrounds/jarvis-cu.png \
 && printf '[*]\nwallpaper_mode=stretch\nwallpaper=/usr/share/backgrounds/jarvis-cu.png\ndesktop_bg=#0f1620\ndesktop_fg=#e6edf3\nshow_documents=1\nshow_trash=0\nshow_mounts=0\n' \
      > /home/cu/.config/pcmanfm/default/desktop-items-0.conf \
 && printf '[Desktop Entry]\nType=Application\nName=Terminal\nExec=xterm\nIcon=utilities-terminal\nTerminal=false\n' > /home/cu/Desktop/terminal.desktop \
 && printf '[Desktop Entry]\nType=Application\nName=Files\nExec=pcmanfm\nIcon=system-file-manager\nTerminal=false\n' > /home/cu/Desktop/files.desktop \
 && printf '[Desktop Entry]\nType=Application\nName=Text Editor\nExec=mousepad\nIcon=accessories-text-editor\nTerminal=false\n' > /home/cu/Desktop/editor.desktop \
 && printf '[Desktop Entry]\nType=Application\nName=Firefox\nExec=firefox\nIcon=firefox-esr\nTerminal=false\n' > /home/cu/Desktop/firefox.desktop \
 && chmod +x /home/cu/Desktop/*.desktop \
 && chown -R cu:cu /home/cu/.config /home/cu/Desktop

# Start-menu button in the panel (2026-07-06 "why is there no menu button"):
# tint2 is a minimal panel (taskbar+clock only by default) and openbox's app
# menu is stolen by pcmanfm's desktop right-click, so nothing gave a launcher
# button. Add a labelled tint2 button that pops a jgmenu list of the apps.
# jarvis-menu feeds a static CSV to `jgmenu --simple` (text entries render
# without an icon theme, which we don't ship). panel_items=BTSC → Button,
# Taskbar, Systray, Clock.
RUN printf '#!/bin/sh\nprintf "Terminal,xterm\\nFiles,pcmanfm\\nText Editor,mousepad\\nFirefox,firefox\\n" | jgmenu --simple\n' > /usr/local/bin/jarvis-menu \
 && chmod +x /usr/local/bin/jarvis-menu \
 && mkdir -p /home/cu/.config/tint2 \
 && printf 'panel_items = BTSC\npanel_size = 100%% 32\npanel_background_id = 1\nbackground_id = 1\nrounded = 0\nbackground_color = #0f1620 100\nbutton = new\nbutton_text = Menu\nbutton_lclick_command = jarvis-menu\nbutton_font_color = #e6edf3 100\nbutton_padding = 12 2\ntime1_format = %%H:%%M\n' \
      > /home/cu/.config/tint2/tint2rc \
 && chown -R cu:cu /home/cu/.config/tint2

USER cu

# JARVIS_CU_DESKTOP_APPS: named + appended to the CU system prompt (cloud only)
# so the agent knows these exist and how to launch them — this desktop has no
# start menu/dock, and without the hint the agent wrongly reports "no terminal"
# (live 2026-07-06). The local Moon desktop leaves this unset → no false hint.
ENV DISPLAY=:99 \
    JARVIS_COMPUTER_USE_WEB_PORT=8771 \
    JARVIS_COMPUTER_USE_WEB_HOST=0.0.0.0 \
    JARVIS_CU_WS_PORT=6080 \
    JARVIS_CU_BASH=1 \
    JARVIS_CU_DESKTOP_APPS="a terminal (xterm), a file manager (pcmanfm), a text editor (mousepad), and a web browser (firefox)"
EXPOSE 8771 6080
ENTRYPOINT ["/app/start.sh"]
