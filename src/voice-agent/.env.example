# JARVIS voice-agent — environment template
# Copy to .env (gitignored) and fill in the values that apply.
#
# This file lists ONLY the bootstrap vars needed by the systemd unit
# and the LiveKit client. API keys (DeepSeek, OpenAI, Anthropic,
# Kimi, Google) live in ~/.jarvis/keys.env so they survive across
# repo checkouts and aren't accidentally committed. _load_user_keys_env()
# in jarvis_agent.py reads keys.env at startup; values there override
# repo .env values on collision.
#
# Optional JARVIS_* tuning knobs are documented in their respective
# modules — grep `os.environ.get("JARVIS_` for the full surface area.
#
# Provider API keys (Anthropic, DeepSeek, OpenAI, Deepgram, Brave, Honcho,
# Spotify, etc.) go in ~/.jarvis/keys.env — see the
# committed `keys.env.example` (same directory as this file) for the
# full documented catalog.

# ── LiveKit SFU (required) ────────────────────────────────────────────
# URL of the local livekit-server. The keypair must match livekit.yaml
# (the agent uses these to authenticate its SFU connection). Rotate
# both at once if you rotate one.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Display environment (required for desktop tools) ──────────────────
# Set so xdotool/scrot can find the active X server when the agent
# runs under a systemd user unit. JARVIS_USER_UID is read by some
# subprocess shims to drop privileges back to the user.
DISPLAY=:0
XAUTHORITY=/home/ulrich/.Xauthority

# ── Edge TTS fallback voice (optional, has default) ───────────────────
# Microsoft Edge neural-TTS voice used as the FallbackAdapter safety
# net when the on-device Kokoro TTS fails. Voice IDs:
#   https://learn.microsoft.com/azure/cognitive-services/speech-service/language-support
JARVIS_EDGE_VOICE=en-US-ChristopherNeural

# ── Slow-path classifier (optional, JARVIS_GRAPH_DISABLED=1 reverts) ──
# Which LLM the LangGraph turn-router uses for BANTER/TASK/REASONING/
# EMOTIONAL classification. Default OpenAI gpt-4o-mini.
# JARVIS_ROUTER_PROVIDER=openai
# JARVIS_ROUTER_MODEL=gpt-4o-mini

# ── Echo-aware barge-in (recommended) ────────────────────────────────
# Reduces echo-driven false interrupts when JARVIS hears its own TTS
# back through the mic. See MEMORY:project_aec_echo_stt_regression.
JARVIS_ECHO_AWARE_BARGEIN=1

# ── Cloud memory (optional, default OFF) ─────────────────────────────
# JARVIS_CLOUD_MEMORY=1 repoints curated memory (USER/MEMORY/PROCEDURES,
# the `memory` tool + frozen prompt snapshot) and semantic recall (the
# `recall` tool + turn sync) at the SHARED cloud store — the web app's
# /api/memory + /api/recall — so the local agent, phone, and cloud voice
# all use ONE memory. Cloud is primary when reachable; on ANY error or
# timeout every call falls back to the existing local path (file-backed
# memories / local honcho), and the cloud snapshot is mirrored into the
# local files at session start so offline sessions boot from the
# last-seen cloud state. Unset/0 (default) = current pure-local
# behavior, byte-identical.
# JARVIS_CLOUD_MEMORY=1
#
# The cloud web-app user id that keys the shared store (REQUIRED when
# the flag is on — the single web user's id):
# JARVIS_CLOUD_USER_ID=a6825d5c-4b5a-4231-867e-44964ab9685e
#
# Cloud web-app base URL. Deliberately a SEPARATE var from
# JARVIS_WEB_URL, which means the LOCAL web app on this box (default
# http://127.0.0.1:3000) and is consumed by the web_* workbench tools —
# do not repoint that one.
# JARVIS_CLOUD_MEMORY_URL=https://0wlan.com
#
# Auth: requests carry an HS256 proxy JWT (sub="voice-agent") minted
# from JARVIS_PROXY_JWT_SECRET, which lives in ~/.jarvis/keys.env
# (auto-loaded at startup) and must match the web app's secret.

# ── Plugins / skills discovery (optional overrides) ──────────────────
# Comma list of plugin slugs to skip at boot:
# JARVIS_PLUGINS_DISABLED=
# Override bundled-plugins directory (default: src/voice-agent/plugins/):
# JARVIS_BUNDLED_PLUGINS=
# Override user-plugins directory (default: ~/.jarvis/plugins/):
# JARVIS_USER_PLUGINS=
# Colon-separated skill discovery roots (defaults to bundled + user):
# JARVIS_SKILLS_PATHS=

# ── Offline / on-device voice (no internet) ──────────────────────────────
# install.sh seeds these on a fresh box; documented here for hand-config.
# Local LLM failover: the on-device Ollama model is the LAST FallbackAdapter
# rung, reached only after every cloud rung fails (WiFi loss / providers down).
# JARVIS_LOCAL_LLM_FAILOVER=1
# JARVIS_LOCAL_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M   # registry-pullable; routed via a derived -jarvis-ctx:12288 variant at runtime (Ollama /v1 ignores request num_ctx)
# JARVIS_LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# Pinned-supervisor baseline the offline path assumes (one model, all routes):
# JARVIS_PIN_ALL_ROUTES=1
# JARVIS_PIN_FALLBACK_MODEL=kimi-k2.6-instant
# Local STT (faster-whisper, GPU) + TTS (Kokoro) — fully on-device:
# JARVIS_STT_LOCAL_ONLY=1
# JARVIS_LOCAL_STT_MODEL=large-v3-turbo
# JARVIS_LOCAL_TTS_ENABLED=1
# JARVIS_LOCAL_TTS_ENGINE=kokoro
# NOTE: the WebRTC media transport is pinned to the jarvis0 dummy NIC via
# src/voice-agent/livekit.yaml (jarvis-net.service) so audio survives WiFi loss.
