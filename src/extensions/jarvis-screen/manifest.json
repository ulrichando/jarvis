{
  "manifest_version": 3,
  "name": "Jarvis",
  "version": "3.0.0",
  "description": "Lets Jarvis act on web pages. The service worker holds a WebSocket to the local Jarvis bridge (127.0.0.1:8765); Jarvis sends deterministic commands (navigate, click, type, read) that run in the active tab.",
  "permissions": [
    "tabs",
    "webNavigation",
    "cookies",
    "storage",
    "sidePanel",
    "identity",
    "downloads",
    "notifications",
    "alarms",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "settings.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["console_hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["safety.js", "actions.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": { "default_path": "side_panel.html" },
  "action": {
    "default_title": "Jarvis",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
