# LiveKit server (P1, /opt/jarvis/livekit) — worker registration.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM gateway (the "hub", web-hub-1). The agent mints its own HS256
# proxy JWTs from this secret (same value the hub verifies with — it
# lives in /opt/jarvis/src/web/.env.production on the VPS).
JARVIS_GATEWAY_URL=http://localhost:4000
JARVIS_PROXY_JWT_SECRET=

# Web app base URL for cloud voice memory (/api/voice-memory). Turns are
# stored in the web Postgres (the JSONL under VOICE_MEMORY_DIR stays as
# the offline fallback). Authed with a service proxy JWT minted from the
# same JARVIS_PROXY_JWT_SECRET.
JARVIS_WEB_URL=http://127.0.0.1:80

# Pipeline knobs (defaults shown).
VOICE_LLM_MODEL=claude-sonnet-4-6
VOICE_STT_MODEL=small.en
VOICE_STT_LANGUAGE=en
VOICE_TTS_VOICE=en-GB-RyanNeural
# VOICE_GREETING=Online.

# Live type-as-you-speak transcription (interim results). While the user
# speaks, a small whisper model re-decodes the utterance on a bounded
# cadence and streams a self-revising hypothesis to the phone; the final
# transcript is still ONE clean decode with VOICE_STT_MODEL and the full
# anti-hallucination guards. Set VOICE_STT_STREAMING=0 to fall back to the
# proven finals-only path (no interims, StreamAdapter).
VOICE_STT_STREAMING=1
# Interim decode model (cpu/int8). tiny.en is ~5-10x faster than small.en;
# it's display-only, the final decode fixes its mistakes. Baked into the
# docker image (STT_INTERIM_MODEL build arg) — another value downloads
# once to the container fs at first use.
VOICE_STT_INTERIM_MODEL=tiny.en
# Min seconds between interim decodes (clamped 0.25-2.0). Decodes are
# single-flight: a slow decode self-throttles, this only floors the pace.
VOICE_STT_INTERIM_INTERVAL=0.5
# Max seconds of utterance audio re-decoded per interim tick (clamped
# 4-30). Longer utterances trim old audio at a segment boundary and freeze
# its text in the display — caps CPU per tick on the shared 4-vCPU box.
VOICE_STT_INTERIM_WINDOW=10
