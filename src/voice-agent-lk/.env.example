# LiveKit server (P1, /opt/jarvis/livekit) — worker registration.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM gateway (the "hub", web-hub-1). The agent mints its own HS256
# proxy JWTs from this secret (same value the hub verifies with — it
# lives in /opt/jarvis/src/web/.env.production on the VPS).
JARVIS_GATEWAY_URL=http://localhost:4000
JARVIS_PROXY_JWT_SECRET=

# Web app base URL for cloud voice memory (/api/voice-memory). Turns are
# stored in the web Postgres (the JSONL under VOICE_MEMORY_DIR stays as
# the offline fallback). Authed with a service proxy JWT minted from the
# same JARVIS_PROXY_JWT_SECRET.
JARVIS_WEB_URL=http://127.0.0.1:80

# Pipeline knobs (defaults shown).
VOICE_LLM_MODEL=claude-sonnet-4-6
VOICE_STT_MODEL=base.en
VOICE_STT_LANGUAGE=en
VOICE_TTS_VOICE=en-GB-RyanNeural
# VOICE_GREETING=Online.
