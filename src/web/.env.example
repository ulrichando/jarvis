# ─── LLM providers ────────────────────────────────────────────
# Fill in the ones you want to use. Empty = model hidden / errors at call time.

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT-5, o3)
OPENAI_API_KEY=

# Google (Gemini) — key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# DeepSeek (V3, R1)
DEEPSEEK_API_KEY=

# Kimi / Moonshot (optional override of base URL)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1

# ─── Kimi K2.6 modes (web chat) ────────────────────────────────
# Off by default. When set to "1", kimi-k2-{instant,thinking,agent,swarm}
# model selections route through src/lib/ai/kimi/ instead of the legacy
# single-call path. Spec: docs/superpowers/specs/2026-05-05-kimi-k2-modes-web-design.md
KIMI_K2_MODES_ENABLED=0

# Per-day cost ceiling (USD) for the Swarm mode. Default $5.00.
# Counted by Redis key kimi:swarm:spend:YYYY-MM-DD with end-of-UTC-day expiry.
KIMI_SWARM_DAILY_BUDGET_USD=5.00

# Swarm budget tracker uses the JARVIS hub Redis (already used by other
# server modules). Falls back to local Redis at 127.0.0.1:6379 if unset.
# JARVIS_HUB_URL=redis://localhost:6379

# ─── Persistence (optional — in-memory chat works without it) ─
# Free Postgres: neon.tech or supabase.com
DATABASE_URL=

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Voice-mode speech-to-text (/api/stt). Defaults to OpenAI's transcription API
# using OPENAI_API_KEY above; point at any OpenAI-compatible server (e.g.
# self-hosted faster-whisper) to swap providers without a code change.
# JARVIS_STT_URL=https://api.openai.com/v1/audio/transcriptions
# JARVIS_STT_MODEL=gpt-4o-mini-transcribe
# JARVIS_STT_API_KEY=

# LiveKit realtime voice (POST /api/livekit/token) — key pair + public WSS URL
# of the self-hosted LiveKit server. Unset = endpoint answers 503.
# LIVEKIT_URL=wss://livekit.example.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Web search (/api/voice-search + the hub's chat web_search). Brave Search API
# is the primary source when set (free plan ~2000 q/mo, 1 req/s — throttled in
# the pipeline; brave.com/search/api). Unset = keyless SearXNG → DuckDuckGo.
# Tunables (SEARCH_FETCH_PAGES, SEARCH_FETCH_TIMEOUT_MS, …) are documented in
# .env.production.example and src/lib/search/pipeline.ts.
# BRAVE_SEARCH_API_KEY=
# SEARXNG_URL=http://127.0.0.1:8888

# Semantic rerank of search results (Cohere Rerank or Jina Reranker). ONE key
# enables it; no key = heuristic rerank (today's behavior). Query rewriting is
# tunable via SEARCH_QUERY_REWRITE (off|heuristic|llm, default heuristic).
# Full var list + defaults in .env.production.example and src/lib/search/pipeline.ts.
# COHERE_API_KEY=
# JINA_API_KEY=
# RERANK_PROVIDER=auto
# VOICE_SEARCH_RERANK=0
