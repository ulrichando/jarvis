# Caddy — plain-HTTP origin behind the host's cloudflared tunnel (Cloudflare
# terminates TLS at the edge; the tunnel delivers to localhost:80). This is the
# LIVE production shape on the VPS. The previous origin-TLS shape
# ({$JARVIS_DOMAIN} + Cloudflare Origin Certificate on :443) is in git history —
# restore it only if you front this with a proxied DNS record instead of a
# tunnel.
:80 {
	encode zstd gzip

	# searx.0wlan.com → SearXNG (JARVIS's keyless web_search backend).
	# Hostname-routed here; the public hostname is a cloudflared ingress rule
	# EXCLUDED from Cloudflare Access (same pattern as /install.sh + /releases).
	@searx host searx.0wlan.com
	reverse_proxy @searx searxng:8080

	# gh.0wlan.com → JARVIS GitHub App (webhook + setup). Same
	# Access-EXCLUDED cloudflared ingress pattern as searx — GitHub's webhook
	# POSTs can't pass SSO; the HMAC signature on /webhook is the auth.
	@ghapp host gh.0wlan.com
	reverse_proxy @ghapp gh-app:8790

	# /code terminal websocket → the pty-server (8772). Rides the tunnel + app
	# auth; the socket additionally requires a per-session HS256 token in its
	# init frame (JARVIS_PTY_REQUIRE_AUTH=1 in compose).
	@pty path /pty /pty/*
	reverse_proxy @pty web:8772

	# /cu-vnc → the computer-use container's websockify (:6080) for the live
	# noVNC desktop. Rides the tunnel + app login + Cloudflare Access (do NOT
	# exclude /cu-vnc from Access) + the VNC password. Mirrors the /pty pattern.
	@cuvnc path /cu-vnc /cu-vnc/*
	reverse_proxy @cuvnc computer-use:6080

	reverse_proxy web:3000

	# Baseline origin headers — Cloudflare WAF/Access are the primary edge layer.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# livekit.0wlan.com → LiveKit realtime SFU (host-net :7880). GREY-CLOUD direct
# A record (bypasses the tunnel); caddy terminates TLS here. Signaling only —
# WebRTC media goes direct UDP to the public IP (use_external_ip).
livekit.0wlan.com {
	reverse_proxy 172.18.0.1:7880
}
