# JARVIS web — production env template. Copy to .env.production (gitignored)
# and fill in. For real prod, source these from a secrets manager instead of
# a file on disk (see docs/runbook/deploy-online.md).

# ── Identity / host (blocker #3) ────────────────────────────────────────────
JARVIS_DOMAIN=jarvis.example.com
JARVIS_WEB_ALLOWED_HOSTS=jarvis.example.com   # else every /api/* 403s
JARVIS_CANONICAL_HOST=jarvis.example.com
BETTER_AUTH_URL=https://jarvis.example.com
JARVIS_REQUIRE_LOCAL_AUTH=1
JARVIS_LOCAL_API_TOKEN=                        # openssl rand -hex 32
BETTER_AUTH_SECRET=                            # openssl rand -hex 32 (required — app errors on the default)
# Signs the per-session /code terminal (PTY) token AND the local-proxy token.
# Set it explicitly in prod so the value is stable across container recreates
# (the app otherwise lazy-creates it in ~/.jarvis/keys.env, which an ephemeral
# container loses on restart, silently rotating it).
JARVIS_PROXY_JWT_SECRET=                        # openssl rand -base64 32
NEXT_PUBLIC_PTY_URL=wss://jarvis.example.com/pty  # BUILD-TIME: /code terminal endpoint (via Caddy)

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=                             # openssl rand -base64 24 (rotated!)
DATABASE_URL=postgresql://jarvis:CHANGEME@postgres:5432/jarvis

# ── Sandbox (the hardened executor) ─────────────────────────────────────────
JARVIS_WORKSPACES_ROOT=/srv/jarvis/workspaces  # HOST path (DooD bind mounts)
JARVIS_SANDBOX_READONLY=1
# JARVIS_SANDBOX_NETWORK=none                   # uncomment for zero-egress sandboxes
# JARVIS_SANDBOX_RUNTIME=runsc                  # gVisor (install runsc on the host first)

# ── Provider keys (ROTATED — old ones are in git history) ───────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
KIMI_API_KEY=
# Voice-mode speech-to-text (/api/stt) — defaults to OpenAI's transcription API
# via OPENAI_API_KEY above; override for a self-hosted OpenAI-compatible server.
# JARVIS_STT_URL=https://api.openai.com/v1/audio/transcriptions
# JARVIS_STT_MODEL=gpt-4o-mini-transcribe
# JARVIS_STT_API_KEY=

# ── Web search (chat web_search via the hub + voice /api/voice-search) ──────
# Brave Search API key — the PRIMARY search source when set (the datacenter
# IP degrades SearXNG to bing homepages + mwmbl junk; Brave returns real
# ranked results). Free plan: ~2000 queries/mo, 1 req/s (the pipeline
# throttles + retries accordingly). Get one at brave.com/search/api.
# Read by BOTH the `web` service (voice-search route) and the `hub` service
# (chat web_search) — both load this file via env_file. Unset = the keyless
# SearXNG → DuckDuckGo chain, exactly the pre-Brave behavior.
BRAVE_SEARCH_API_KEY=
# Optional pipeline tunables (defaults shown; see src/lib/search/pipeline.ts):
# SEARCH_MAX_RESULTS=8            # cleaned results per search
# SEARCH_FETCH_PAGES=3            # chat: top pages fetched for real content (0=off)
# SEARCH_FETCH_TIMEOUT_MS=2500    # per-page fetch timeout
# SEARCH_FETCH_BUDGET_MS=4000     # overall content-fetch budget per search
# SEARCH_CONTENT_MAX_CHARS=4000   # extracted text cap per page
# Voice keeps search snappy: with Brave it skips page fetches (extra_snippets
# already carry real text); the keyless fallback fetches 2 pages under ~2s.
# VOICE_SEARCH_FETCH_PAGES=       # override the auto behavior (0 = never fetch)
# VOICE_SEARCH_FETCH_TIMEOUT_MS=2000
#
# ── Semantic rerank (Cohere Rerank / Jina Reranker) ─────────────────────────
# Rescores search results by true relevance to the query after retrieval +
# content extraction — the precision stage of the research pipeline. Set ONE
# key to enable (read by both `hub` and `web`); NO key = the existing
# heuristic rerank, exactly today's behavior. Cohere trial keys: 10 req/min,
# ~1000 calls/mo (dashboard.cohere.com). Jina free keys: 10M tokens, ~100
# req/min (jina.ai). The pipeline throttles client-side and every miss
# (timeout / 429 / error) falls back to the heuristic order.
# COHERE_API_KEY=
# JINA_API_KEY=
# RERANK_PROVIDER=auto            # auto | cohere | jina | off (auto = by key, Cohere first)
# RERANK_MODEL=                   # default: cohere rerank-v3.5 / jina jina-reranker-v2-base-multilingual
# RERANK_TOP_N=8                  # results the rerank API scores
# RERANK_TIMEOUT_MS=1200          # chat-path hard budget; miss = heuristic order
# RERANK_MAX_PER_MINUTE=8         # client-side throttle (under Cohere trial 10/min)
# VOICE_SEARCH_RERANK=0           # 1 = rerank voice searches too (bounded below)
# VOICE_SEARCH_RERANK_TIMEOUT_MS=700
#
# ── Query rewriting / decomposition (chat web_search via the hub) ───────────
# Stage 1 of the research pass: turn the raw question into 1-3 retrieval
# queries (strip filler, split compound questions). heuristic = pure string
# work, free + the default. llm = one small completion through the hub's
# provider path, bounded by the timeout, heuristic fallback on any failure.
# off = single-query, exactly the pre-rewrite behavior.
# NOTE: each extra decomposed query costs ~1.05s + quota on Brave's free tier
# (1 req/s serialization) — hence the default cap of 2.
# SEARCH_QUERY_REWRITE=heuristic  # off | heuristic | llm
# SEARCH_REWRITE_MAX_QUERIES=2    # decomposition cap (1..3)
# SEARCH_REWRITE_TIMEOUT_MS=1500  # llm-rewrite budget
# SEARCH_REWRITE_MODEL=           # registry model id for llm mode (unset = default provider)
# VOICE_SEARCH_QUERY_REWRITE=off  # voice: off (default) | heuristic — query already comes from the agent LLM

# ── LiveKit realtime voice (POST /api/livekit/token) ────────────────────────
# Key pair of the self-hosted LiveKit server (compose service on this box —
# copy from /opt/jarvis/livekit/keys.env). All three must be set or the token
# endpoint answers 503 and the phone's realtime voice mode is unavailable.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Honcho semantic recall (voice `recall` tool, POST /api/recall) ──────────
# OPTIONAL — self-hosted honcho stack, provisioned by
# setup/honcho/setup-honcho-vps.sh (pinned v3.0.9, co-located, never exposed;
# see docs/runbook/honcho-cloud-recall.md — note the ongoing OpenAI deriver
# cost). While HONCHO_BASE_URL is unset /api/recall fails SOFT: recall
# queries return empty, turn syncs no-op — the voice path never breaks.
# In-compose the honcho api rides the private jarvis-honcho network under the
# DNS alias `honcho`; for non-container local dev use http://127.0.0.1:8000.
# HONCHO_BASE_URL=http://honcho:8000
# With AUTH_USE_AUTH=false (this deploy shape) honcho ignores the credential —
# any placeholder works; the value is only load-bearing if honcho auth is on.
# HONCHO_API_KEY=local
# HONCHO_WORKSPACE_ID=default
