# JARVIS web — production env template. Copy to .env.production (gitignored)
# and fill in. For real prod, source these from a secrets manager instead of
# a file on disk (see docs/runbook/deploy-online.md).

# ── Identity / host (blocker #3) ────────────────────────────────────────────
JARVIS_DOMAIN=jarvis.example.com
JARVIS_WEB_ALLOWED_HOSTS=jarvis.example.com   # else every /api/* 403s
JARVIS_CANONICAL_HOST=jarvis.example.com
BETTER_AUTH_URL=https://jarvis.example.com
JARVIS_REQUIRE_LOCAL_AUTH=1
JARVIS_LOCAL_API_TOKEN=                        # openssl rand -hex 32
BETTER_AUTH_SECRET=                            # openssl rand -hex 32 (required — app errors on the default)
# Signs the per-session /code terminal (PTY) token AND the local-proxy token.
# Set it explicitly in prod so the value is stable across container recreates
# (the app otherwise lazy-creates it in ~/.jarvis/keys.env, which an ephemeral
# container loses on restart, silently rotating it).
JARVIS_PROXY_JWT_SECRET=                        # openssl rand -base64 32
NEXT_PUBLIC_PTY_URL=wss://jarvis.example.com/pty  # BUILD-TIME: /code terminal endpoint (via Caddy)

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=                             # openssl rand -base64 24 (rotated!)
DATABASE_URL=postgresql://jarvis:CHANGEME@postgres:5432/jarvis

# ── Sandbox (the hardened executor) ─────────────────────────────────────────
JARVIS_WORKSPACES_ROOT=/srv/jarvis/workspaces  # HOST path (DooD bind mounts)
JARVIS_SANDBOX_READONLY=1
# JARVIS_SANDBOX_NETWORK=none                   # uncomment for zero-egress sandboxes
# JARVIS_SANDBOX_RUNTIME=runsc                  # gVisor (install runsc on the host first)

# ── Provider keys (ROTATED — old ones are in git history) ───────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
KIMI_API_KEY=
# Voice-mode speech-to-text (/api/stt) — defaults to OpenAI's transcription API
# via OPENAI_API_KEY above; override for a self-hosted OpenAI-compatible server.
# JARVIS_STT_URL=https://api.openai.com/v1/audio/transcriptions
# JARVIS_STT_MODEL=gpt-4o-mini-transcribe
# JARVIS_STT_API_KEY=

# ── LiveKit realtime voice (POST /api/livekit/token) ────────────────────────
# Key pair of the self-hosted LiveKit server (compose service on this box —
# copy from /opt/jarvis/livekit/keys.env). All three must be set or the token
# endpoint answers 503 and the phone's realtime voice mode is unavailable.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Honcho semantic recall (voice `recall` tool, POST /api/recall) ──────────
# OPTIONAL — self-hosted honcho stack, provisioned by
# setup/honcho/setup-honcho-vps.sh (pinned v3.0.9, co-located, never exposed;
# see docs/runbook/honcho-cloud-recall.md — note the ongoing OpenAI deriver
# cost). While HONCHO_BASE_URL is unset /api/recall fails SOFT: recall
# queries return empty, turn syncs no-op — the voice path never breaks.
# In-compose the honcho api rides the private jarvis-honcho network under the
# DNS alias `honcho`; for non-container local dev use http://127.0.0.1:8000.
# HONCHO_BASE_URL=http://honcho:8000
# With AUTH_USE_AUTH=false (this deploy shape) honcho ignores the credential —
# any placeholder works; the value is only load-bearing if honcho auth is on.
# HONCHO_API_KEY=local
# HONCHO_WORKSPACE_ID=default
