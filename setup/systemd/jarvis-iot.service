# JARVIS IoT discovery sidecar — local-network device discovery/identification
# behind the voice smart_home tool and the web Devices tab (:8779, loopback).
# Decoupled from jarvis-voice-agent.service on purpose (mirrors
# jarvis-computer-use.service).
#
# Enable (NOT auto-enabled — operator opt-in):
#   systemctl --user daemon-reload
#   systemctl --user enable --now jarvis-iot.service

[Unit]
Description=JARVIS IoT discovery service (:8779)
After=network-online.target
# Page off-box if this lands in a failed state (mirrors the voice units).
OnFailure=jarvis-alert@%n.service

[Service]
Type=simple
WorkingDirectory=%h/Documents/Projects/jarvis/src/voice-agent
ExecStart=%h/Documents/Projects/jarvis/src/voice-agent/.venv/bin/python -m iot.service
Environment=JARVIS_IOT_PORT=8779
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
