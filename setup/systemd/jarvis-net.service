# SYSTEM unit (installed to /etc/systemd/system by install.sh — NOT a --user
# unit, because creating a network interface needs root).
#
# Creates a dummy NIC `jarvis0` at 10.201.0.1/24 that LiveKit pins its WebRTC
# media to (see src/voice-agent/livekit.yaml rtc.node_ip / interfaces). Why a
# dummy interface:
#   - ALWAYS up: independent of WiFi (wlan0) AND Docker (docker0), so the audio
#     ICE path never loses its candidate when WiFi drops → offline voice holds.
#   - non-loopback: libwebrtc CLIENTS filter 127.0.0.1, so `lo` can't carry the
#     media (tested: wait_pc_connection timed out); a dummy NIC is gathered like
#     any real interface.
# Idempotent: skips creation if jarvis0 already exists. Comes up before the
# network + the (later, --user) livekit-server so the interface is present when
# the SFU gathers candidates.
[Unit]
Description=JARVIS stable dummy NIC (jarvis0) for LiveKit WebRTC media
Documentation=https://github.com/livekit/livekit
After=network-pre.target
Before=network.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'ip link show jarvis0 >/dev/null 2>&1 || { ip link add jarvis0 type dummy && ip addr add 10.201.0.1/24 dev jarvis0 && ip link set jarvis0 up; }'
ExecStop=/bin/sh -c 'ip link del jarvis0 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
